                "exec": [
                  "// Converte a resposta\r\nconst responseData = pm.response.json();\r\nconsole.log(\"Resposta recebida do Backend:\", responseData);\r\n\r\n// Tenta encontrar o token nas estruturas de resposta mais comuns\r\nconst token = responseData.token \r\n           || responseData.accessToken \r\n           || responseData.access_token \r\n           || responseData.jwt\r\n           || responseData.data?.token\r\n           || responseData.data?.accessToken\r\n           || responseData.data?.access_token;\r\n\r\nif (token) {\r\n    // Salva na Coleção (não depende de selecionar um Environment no topo)\r\n    pm.collectionVariables.set(\"token\", token);\r\n    \r\n    // Salva no Ambiente ativo (caso esteja usando um)\r\n    pm.environment.set(\"token\", token);\r\n\r\n    console.log(\"✅ TOKEN SALVO COM SUCESSO:\", token);\r\n} else {\r\n    console.error(\"❌ ERRO: O campo de token não foi encontrado no JSON de resposta.\");\r\n}"
                ]
              }
            }
